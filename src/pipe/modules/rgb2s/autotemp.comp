#version 460
#extension GL_GOOGLE_include_directive : enable
#include "shared.glsl"
#include "shared/spectral.glsl"
#include "colourspaces.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 1) uniform params_t
{
  vec4 value;
  vec4 auto_wb;
} params;

layout(push_constant, std140) uniform push_t { int have_pick; } push;

layout(set = 1, binding = 0) uniform sampler2D img_sclut;
layout(set = 1, binding = 1) uniform writeonly image2D img_temp;
layout(set = 1, binding = 2) uniform sampler2D img_pick;

void tri2quad(inout vec2 tc)
{
  tc.y = tc.y / (1.0-tc.x);
  tc.x = (1.0-tc.x)*(1.0-tc.x);
}

// Returns rec2020 chromaticity (normalized to unit sum) of the reflectance
// encoded at sclut anchor idx. The scale band (camera_to_ref) is a radiometric
// gain and must not be used for chromaticity matching.
vec2 sclut_chroma(vec2 tc, int idx, int n)
{
  vec4 cf = texture(img_sclut, vec2((tc.x + float(idx)) / float(2 * n), tc.y));
  vec3 xyz = vec3(0.0);
  for(int i=0; i<spectral_groups; i++)
  {
    vec4 l = spectral_lambda[i];
    vec4 x = (cf.x*l + cf.y)*l + cf.z;
    vec4 refl = 0.5*x*inversesqrt(x*x+1.0) + 0.5;
    vec4 rad = refl * spectral_d65(i);
    xyz.x += dot(rad, spectral_cmf_x[i]);
    xyz.y += dot(rad, spectral_cmf_y[i]);
    xyz.z += dot(rad, spectral_cmf_z[i]);
  }
  xyz *= spectral_step_nm;
  vec3 rec2020 = XYZ_to_rec2020(xyz);
  return rec2020.xz / max(rec2020.x + rec2020.y + rec2020.z, 1e-8);
}

void main()
{
  if(params.value.x > 0.0) { imageStore(img_temp, ivec2(0), vec4(-1.0)); return; }

  ivec2 clut_size = textureSize(img_sclut, 0);
  int n = max(1, clut_size.x / (2 * clut_size.y));

  vec3 neutral = vec3(1.0/max(params.auto_wb.r, 1e-6), 1.0, 1.0/max(params.auto_wb.b, 1e-6));
  if(push.have_pick != 0)
  {
    neutral = vec3(
        texelFetch(img_pick, ivec2(0, 0), 0).r,
        texelFetch(img_pick, ivec2(0, 1), 0).r,
        texelFetch(img_pick, ivec2(0, 2), 0).r);
  }
  float nb = max(neutral.r+neutral.g+neutral.b, 1e-6);
  vec2 ntc = neutral.rb/nb;
  tri2quad(ntc);

  const vec2 target = vec2(1.0/3.0);
  vec2 rb_prev = sclut_chroma(ntc, 0, n);
  float best_bp = 0.0, best_res = 1e30;
  for(int k=0; k<n-1; k++)
  {
    vec2 rb_next = sclut_chroma(ntc, k+1, n);
    vec2 dv = rb_next - rb_prev;
    float denom = dot(dv, dv);
    float m = denom > 1e-12 ? dot(target-rb_prev, dv)/denom : 0.0;
    float mc = clamp(m, 0.0, 1.0);
    float res = length(target-(rb_prev+mc*dv));
    if(res < best_res) { best_res = res; best_bp = float(k)+mc; }
    rb_prev = rb_next;
  }
  imageStore(img_temp, ivec2(0), vec4(best_bp/float(max(n-1, 1))));
}
